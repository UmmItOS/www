{
  "name": "ummit-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "dev": "NODE_OPTIONS=--no-deprecation next dev --turbo",
    "dev:fast": "NEXT_DIST_DIR=/tmp/ummitos-next NODE_OPTIONS=--no-deprecation next dev --turbo",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "postinstall": "fumadocs-mdx",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "fumadocs-core": "^16.15.6",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.6",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
